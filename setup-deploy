#!/bin/bash
# ── setup-deploy ──────────────────────────────────────────────────────────────
# Version: 2.1.0
# Usage:
#   setup-deploy                  → setup new project
#   setup-deploy --install        → first time install on this Mac
#   setup-deploy --update         → update deploy engine from GitHub
#   setup-deploy --update-secrets → update server password in Keychain
#   setup-deploy --fix            → auto-fix image name mismatch between
#                                   deploy.config.sh and docker-compose.yml
# ─────────────────────────────────────────────────────────────────────────────

DEPLOY_VERSION="2.1.0"
GITHUB_RAW="https://raw.githubusercontent.com/DeltaInfosoftAdvanceWeb/deploy-tool/main"
DEPLOY_DIR="$HOME/.deploy"

# ── Colors ────────────────────────────────────────────────────────────────────
BOLD='\033[1m'
DIM='\033[2m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
NC='\033[0m'

info()    { printf "${DIM}  %s${NC}\n" "$1"; }
success() { printf "${GREEN}  ✅ %s${NC}\n" "$1"; }
warn()    { printf "${YELLOW}  ⚠️  %s${NC}\n" "$1"; }
err()     { printf "${RED}  ❌ %s${NC}\n" "$1"; }
hint()    { printf "${DIM}     → %s${NC}\n" "$1"; }

header() {
  printf "\n${BOLD}${BLUE}══════════════════════════════════════════${NC}\n"
  printf "${BOLD}${BLUE}  %s${NC}\n" "$1"
  printf "${BOLD}${BLUE}══════════════════════════════════════════${NC}\n\n"
}

section() {
  printf "\n${BOLD}${CYAN}  ── %s${NC}\n" "$1"
}

divider() {
  printf "${DIM}  ──────────────────────────────────────────${NC}\n"
}

# ── Input helpers ─────────────────────────────────────────────────────────────
ask() {
  local prompt="$1"
  local default="$2"
  local value=""
  while [ -z "$value" ]; do
    if [ -n "$default" ]; then
      printf "  ? %s [%s]: " "$prompt" "$default" >&2
    else
      printf "  ? %s: " "$prompt" >&2
    fi
    read value
    if [ -z "$value" ] && [ -n "$default" ]; then
      value="$default"
    fi
    if [ -z "$value" ]; then
      err "This field cannot be empty. Please enter a value." >&2
    fi
  done
  echo "$value"
}

ask_optional() {
  local prompt="$1"
  printf "  ? %s (optional, press Enter to skip): " "$prompt" >&2
  read value
  echo "$value"
}

ask_secret() {
  local prompt="$1"
  local value=""
  while [ -z "$value" ]; do
    printf "  ? %s (hidden): " "$prompt" >&2
    read -s value
    printf "\n" >&2
    if [ -z "$value" ]; then
      err "This field cannot be empty." >&2
    fi
  done
  echo "$value"
}

ask_number() {
  local prompt="$1"
  local default="$2"
  local min="$3"
  local max="$4"
  local value=""
  while true; do
    if [ -n "$default" ]; then
      printf "  ? %s [%s]: " "$prompt" "$default" >&2
    else
      printf "  ? %s: " "$prompt" >&2
    fi
    read value
    if [ -z "$value" ] && [ -n "$default" ]; then
      value="$default"
    fi
    if [ -z "$value" ]; then
      err "This field cannot be empty." >&2; continue
    fi
    if ! echo "$value" | grep -qE '^[0-9]+$'; then
      err "Must be a number. You entered: $value" >&2
      hint "Example: $default" >&2; continue
    fi
    if [ -n "$min" ] && [ "$value" -lt "$min" ]; then
      err "Must be at least $min. You entered: $value" >&2; continue
    fi
    if [ -n "$max" ] && [ "$value" -gt "$max" ]; then
      err "Must be at most $max. You entered: $value" >&2; continue
    fi
    break
  done
  echo "$value"
}

# ── Validators ────────────────────────────────────────────────────────────────
validate_ip() {
  local ip="$1"
  if echo "$ip" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
    local a b c d
    IFS='.' read -r a b c d <<< "$ip"
    [ "$a" -le 255 ] && [ "$b" -le 255 ] && [ "$c" -le 255 ] && [ "$d" -le 255 ]
    return $?
  fi
  return 1
}

validate_port() {
  echo "$1" | grep -qE '^[0-9]+$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

validate_client_name() {
  echo "$1" | grep -qE '^[a-zA-Z0-9_-]+$'
}

validate_url() {
  echo "$1" | grep -qE '^https?://'
}

validate_db_url() {
  local url="$1"
  [ -n "$url" ] && (
    echo "$url" | grep -qiE 'server=|mongodb://|postgresql://|postgres://|mysql://|sqlite:|jdbc:|://'
  )
}

# ── Keychain helpers ──────────────────────────────────────────────────────────
keychain_save() {
  local account="$1"
  local service="$2"
  local secret="$3"
  security delete-generic-password -a "$account" -s "$service" 2>/dev/null || true
  if ! security add-generic-password -a "$account" -s "$service" -w "$secret" 2>/dev/null; then
    err "Failed to save to Keychain."
    exit 1
  fi
}

# ── Install ───────────────────────────────────────────────────────────────────
do_install() {
  header "setup-deploy — First Time Install v$DEPLOY_VERSION"

  info "Creating $DEPLOY_DIR ..."
  mkdir -p "$DEPLOY_DIR"
  success "Created $DEPLOY_DIR"

  info "Downloading deploy engine from GitHub..."
  if curl -fsSL "$GITHUB_RAW/deploy.sh" -o "$DEPLOY_DIR/deploy.sh" 2>/dev/null; then
    chmod +x "$DEPLOY_DIR/deploy.sh"
    success "Deploy engine downloaded"
  else
    err "Failed to download deploy.sh"
    hint "Make sure repo is public: github.com/DeltaInfosoftAdvanceWeb/deploy-tool"
    exit 1
  fi

  mkdir -p "$HOME/bin"
  cp "$0" "$HOME/bin/setup-deploy"
  chmod +x "$HOME/bin/setup-deploy"
  success "Installed setup-deploy to $HOME/bin"

  if ! grep -q 'export PATH="$HOME/bin:$PATH"' "$HOME/.zshrc" 2>/dev/null; then
    printf '\n# deploy-tool\nexport PATH="$HOME/bin:$PATH"\n' >> "$HOME/.zshrc"
    success "Added ~/bin to PATH in ~/.zshrc"
  else
    info "~/bin already in PATH"
  fi

  printf "\n"
  success "Install complete!"
  printf "\n  ${BOLD}Activate:${NC}  source ~/.zshrc\n"
  printf "  ${BOLD}Setup project:${NC}  cd your-project && setup-deploy\n\n"
}

# ── Update ────────────────────────────────────────────────────────────────────
do_update() {
  header "setup-deploy — Update Engine"

  info "Downloading latest deploy.sh..."
  if curl -fsSL "$GITHUB_RAW/deploy.sh" -o "$DEPLOY_DIR/deploy.sh" 2>/dev/null; then
    chmod +x "$DEPLOY_DIR/deploy.sh"
    success "Deploy engine updated"
  else
    err "Failed to download from GitHub"
    hint "Check internet connection or repo visibility"
    exit 1
  fi

  info "Updating setup-deploy CLI..."
  local _tmp_setup
  _tmp_setup=$(mktemp)
  if curl -fsSL "$GITHUB_RAW/setup-deploy" -o "$_tmp_setup" 2>/dev/null; then
    chmod +x "$_tmp_setup"
    mv "$_tmp_setup" "$HOME/bin/setup-deploy"
    success "setup-deploy CLI updated"
  else
    rm -f "$_tmp_setup"
    warn "Could not update setup-deploy CLI"
  fi

  printf "\n"
  success "Update complete!"
  printf "\n"
  # Exit immediately — the current script file was just replaced on disk.
  # If bash reads the next chunk from the new file at the old offset it will
  # execute garbage. Exiting here ensures only the old in-memory code runs.
  exit 0
}

# ── Update secrets ────────────────────────────────────────────────────────────
do_update_secrets() {
  header "setup-deploy — Update Server Password"

  if [ ! -f "deploy.config.sh" ]; then
    err "No deploy.config.sh found in current directory."
    hint "Run from inside your project: cd my-project && setup-deploy --update-secrets"
    exit 1
  fi
  source "deploy.config.sh"

  printf "  Updating secrets for: ${BOLD}%s${NC}\n\n" "$APP_NAME"

  section "Server SSH Password"
  SERVER_PASS=$(ask_secret "New server password")
  keychain_save "$SERVER_USER" "deploy-${APP_NAME}-server" "$SERVER_PASS"
  success "Server password updated in Keychain"

  printf "\n"
  success "Secrets updated for $APP_NAME"
  printf "\n"
}

# ── Setup ─────────────────────────────────────────────────────────────────────
do_setup() {
  header "setup-deploy — New Project Setup v$DEPLOY_VERSION"

  if [ ! -f "package.json" ]; then
    warn "No package.json found. Are you inside a Next.js project folder?"
    hint "Example: cd ~/Downloads/Developer/MyProject"
    printf "  Continue anyway? (y/N): " >&2
    read confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
      printf "  Aborted.\n"; exit 0
    fi
  fi

  printf "  ${DIM}Answer each question. Press Enter to use [default] value.${NC}\n"
  printf "  ${DIM}Server password stored in macOS Keychain. Client URLs saved in config file.${NC}\n\n"

  while true; do

    # ── Step 1: App Name ──────────────────────────────────────────────────────
    section "Step 1 of 8 — App Name"
    info "Label to identify your app (e.g. CostMetrix, DeltaAuth)"
    while true; do
      APP_NAME=$(ask "App name")
      if echo "$APP_NAME" | grep -qE '^[a-zA-Z0-9_-]+$'; then break
      else
        err "Only letters, numbers, hyphens, underscores. No spaces." >&2
        hint "Example: MyApp, delta-auth" >&2
      fi
    done
    APP_NAME_LOWER=$(echo "$APP_NAME" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
    printf "\n"

    # ── Step 2: Docker Image Name ─────────────────────────────────────────────
    section "Step 2 of 8 — Docker Image Name"
    info "Name for the Docker image (lowercase only)"
    while true; do
      IMAGE_NAME=$(ask "Docker image name" "${APP_NAME_LOWER}-app")
      if echo "$IMAGE_NAME" | grep -qE '^[a-z0-9_-]+$'; then break
      else
        err "Must be lowercase with no spaces." >&2
        hint "Example: myapp-app, delta-auth-app" >&2
      fi
    done
    printf "\n"

    # ── Step 3: Tar File Name ─────────────────────────────────────────────────
    section "Step 3 of 8 — Tar File Name"
    info "Name for the exported Docker archive"
    while true; do
      TAR_FILE=$(ask "Tar file name" "${APP_NAME_LOWER}.tar")
      if echo "$TAR_FILE" | grep -qE '\.tar$'; then break
      else
        err "Must end with .tar" >&2
        hint "Example: myapp.tar" >&2
      fi
    done
    printf "\n"

    # ── Step 4: Server IP ─────────────────────────────────────────────────────
    section "Step 4 of 8 — Server IP Address"
    info "IP address of your Linux deployment server"
    while true; do
      SERVER_IP=$(ask "Server IP address (e.g. 192.168.1.249)")
      if validate_ip "$SERVER_IP"; then break
      else
        err "Invalid IP. You entered: $SERVER_IP" >&2
        hint "Must be 4 numbers separated by dots. Example: 192.168.1.249" >&2
      fi
    done
    printf "\n"

    # ── Step 5: Server User ───────────────────────────────────────────────────
    section "Step 5 of 8 — Server SSH Username"
    info "Username to SSH into your server"
    while true; do
      SERVER_USER=$(ask "Server SSH username" "devadmin")
      if echo "$SERVER_USER" | grep -qE '^[a-zA-Z0-9_-]+$'; then break
      else
        err "No spaces or special characters." >&2
        hint "Example: devadmin, ubuntu, root" >&2
      fi
    done
    printf "\n"

    # ── Step 6: App Port ──────────────────────────────────────────────────────
    section "Step 6 of 8 — App Port"
    info "Port your app will run on"
    while true; do
      APP_PORT=$(ask_number "App port" "3000" "1" "65535")
      if validate_port "$APP_PORT"; then break; fi
    done
    printf "\n"

    # ── Step 7: Server Path ───────────────────────────────────────────────────
    section "Step 7 of 8 — Server Folder Path"
    info "Folder on the server where app files will be uploaded"
    SERVER_PATH=$(ask "Server folder path" "~/$APP_NAME_LOWER")
    printf "\n"

    # ── Step 8: API Clients (optional) ────────────────────────────────────────
    section "Step 8 of 8 — API Clients (optional)"
    info "If your app deploys to multiple clients with different API URLs, add them here."
    info "If not applicable (e.g. CostMetrix), enter 0 to skip."
    printf "\n"

    API_CLIENT_COUNT=$(ask_number "How many API clients?" "0" "0" "20")
    printf "\n"

    API_CLIENTS=""
    API_CLIENTS_DISPLAY=""
    API_CLIENT_LINES=""

    i=1
    while [ "$i" -le "$API_CLIENT_COUNT" ]; do
      printf "  ${BOLD}${CYAN}── API Client $i of $API_CLIENT_COUNT ──${NC}\n"

      # Client name
      while true; do
        API_CLIENT_NAME=$(ask "Client name (e.g. GCKC, DARA, Samarth)")
        if validate_client_name "$API_CLIENT_NAME"; then
          if echo "$API_CLIENTS" | grep -qw "$API_CLIENT_NAME"; then
            err "Client name '$API_CLIENT_NAME' already used. Use a unique name." >&2
          else
            break
          fi
        else
          err "Only letters, numbers, hyphens, underscores. No spaces." >&2
          hint "Example: GCKC, DARA, Samarth" >&2
        fi
      done

      # API URL
      while true; do
        API_URL=$(ask "API Base URL for $API_CLIENT_NAME (e.g. https://client.ierp.in/api)")
        if validate_url "$API_URL"; then break
        else
          err "URL must start with http:// or https://" >&2
          hint "Example: https://gckc.ierp.in/DeltaAuthAPI/api" >&2
        fi
      done

      # Client ID (optional)
      API_CLIENT_ID=$(ask_optional "Client ID for $API_CLIENT_NAME")

      API_CLIENTS="$API_CLIENTS $API_CLIENT_NAME"
      if [ -n "$API_CLIENT_ID" ]; then
        API_CLIENT_LINES="${API_CLIENT_LINES}CLIENT_${API_CLIENT_NAME}_URL=\"${API_URL}\"\nCLIENT_${API_CLIENT_NAME}_ID=\"${API_CLIENT_ID}\"\n"
        API_CLIENTS_DISPLAY="${API_CLIENTS_DISPLAY}  - ${API_CLIENT_NAME}: ${API_URL} (ID: ${API_CLIENT_ID})\n"
      else
        API_CLIENT_LINES="${API_CLIENT_LINES}CLIENT_${API_CLIENT_NAME}_URL=\"${API_URL}\"\n"
        API_CLIENTS_DISPLAY="${API_CLIENTS_DISPLAY}  - ${API_CLIENT_NAME}: ${API_URL}\n"
      fi

      i=$((i+1))
      printf "\n"
    done

    API_CLIENTS=$(echo "$API_CLIENTS" | xargs)

    # ── Server password ───────────────────────────────────────────────────────
    section "Server SSH Password"
    info "Password to SSH into your server (hidden, stored in macOS Keychain only)"
    SERVER_PASS=$(ask_secret "Server SSH password")
    keychain_save "$SERVER_USER" "deploy-${APP_NAME}-server" "$SERVER_PASS"
    success "Server password saved to Keychain"
    printf "\n"

    # ── Summary ───────────────────────────────────────────────────────────────
    printf "\n${BOLD}${MAGENTA}══════════════════════════════════════════${NC}\n"
    printf "${BOLD}${MAGENTA}  Review Your Configuration${NC}\n"
    printf "${BOLD}${MAGENTA}══════════════════════════════════════════${NC}\n\n"
    printf "  ${BOLD}App name      :${NC} %s\n" "$APP_NAME"
    printf "  ${BOLD}Docker image  :${NC} %s\n" "$IMAGE_NAME"
    printf "  ${BOLD}Tar file      :${NC} %s\n" "$TAR_FILE"
    printf "  ${BOLD}Server IP     :${NC} %s\n" "$SERVER_IP"
    printf "  ${BOLD}SSH username  :${NC} %s\n" "$SERVER_USER"
    printf "  ${BOLD}App port      :${NC} %s\n" "$APP_PORT"
    printf "  ${BOLD}Server path   :${NC} %s\n" "$SERVER_PATH"
    if [ -n "$API_CLIENTS" ]; then
      printf "  ${BOLD}API clients   :${NC}\n"
      printf "$API_CLIENTS_DISPLAY"
    else
      printf "  ${BOLD}API clients   :${NC} ${DIM}None (single deployment)${NC}\n"
    fi
    printf "  ${BOLD}SSH password  :${NC} ${DIM}(stored in Keychain)${NC}\n"
    printf "\n"
    divider
    printf "\n  ${YELLOW}Does everything look correct?${NC}\n"
    printf "  ${DIM}Press 'y' to save and finish, 'n' to start over.${NC}\n\n"
    printf "  Confirm? (y/N): " >&2
    read final_confirm
    printf "\n"

    if [ "$final_confirm" = "y" ] || [ "$final_confirm" = "Y" ]; then
      break
    else
      warn "Starting over..."
      printf "\n"
    fi
  done

  # ── Write deploy.config.sh ────────────────────────────────────────────────
  info "Writing deploy.config.sh ..."

  {
    printf "# ── Deploy Configuration ────────────────────────────────────────────────────\n"
    printf "# Generated by setup-deploy v%s\n" "$DEPLOY_VERSION"
    printf "# Server password stored in macOS Keychain — NOT here\n"
    printf "# API client URLs are stored here (not secrets)\n\n"
    printf "APP_NAME=\"%s\"\n" "$APP_NAME"
    printf "IMAGE_NAME=\"%s\"\n" "$IMAGE_NAME"
    printf "TAR_FILE=\"%s\"\n" "$TAR_FILE"
    printf "SERVER_IP=\"%s\"\n" "$SERVER_IP"
    printf "SERVER_USER=\"%s\"\n" "$SERVER_USER"
    printf "SERVER_PATH=\"%s\"\n" "$SERVER_PATH"
    printf "APP_PORT=\"%s\"\n" "$APP_PORT"
    printf "\n# API clients (space-separated)\n"
    printf "API_CLIENTS=\"%s\"\n" "$API_CLIENTS"
    if [ -n "$API_CLIENT_LINES" ]; then
      printf "\n# Client URLs and IDs\n"
      printf "$API_CLIENT_LINES"
    fi
  } > deploy.config.sh

  success "deploy.config.sh created"

  # ── Write deploy.sh wrapper ───────────────────────────────────────────────
  info "Writing deploy.sh ..."
  cat > deploy.sh << 'EOF'
#!/bin/bash
# Generated by setup-deploy — safe to commit, no secrets here
source "$HOME/.deploy/deploy.sh" "$@"
EOF
  chmod +x deploy.sh
  success "deploy.sh created"

  # ── Update .gitignore ─────────────────────────────────────────────────────
  info "Updating .gitignore ..."
  [ ! -f ".gitignore" ] && touch .gitignore
  if ! grep -q "deploy.config.sh" .gitignore; then
    printf "\n# deploy tool\ndeploy.config.sh\n" >> .gitignore
    success "deploy.config.sh added to .gitignore"
  else
    info "deploy.config.sh already in .gitignore"
  fi

  # ── Done ─────────────────────────────────────────────────────────────────
  printf "\n${BOLD}${GREEN}══════════════════════════════════════════${NC}\n"
  printf "${BOLD}${GREEN}  ✅ Project setup complete!${NC}\n"
  printf "${BOLD}${GREEN}══════════════════════════════════════════${NC}\n\n"
  printf "  ${BOLD}Files created:${NC}\n"
  printf "  ${DIM}  deploy.sh         — safe to commit${NC}\n"
  printf "  ${DIM}  deploy.config.sh  — gitignored, no secrets${NC}\n\n"
  printf "  ${BOLD}Deploy commands:${NC}\n"
  if [ -n "$API_CLIENTS" ]; then
    printf "  ${CYAN}  ./deploy.sh push --client CLIENTNAME  ${DIM}# deploy for specific client${NC}\n"
    printf "  ${CYAN}  ./deploy.sh push                      ${DIM}# shows client list to pick${NC}\n"
    printf "  ${CYAN}  ./deploy.sh client --list             ${DIM}# list all clients${NC}\n"
    printf "  ${CYAN}  ./deploy.sh client --add              ${DIM}# add new client${NC}\n"
  else
    printf "  ${CYAN}  ./deploy.sh push      ${DIM}# build + upload + restart${NC}\n"
  fi
  printf "  ${CYAN}  ./deploy.sh restart   ${DIM}# just restart server${NC}\n"
  printf "  ${CYAN}  ./deploy.sh logs      ${DIM}# tail live logs${NC}\n"
  printf "  ${CYAN}  ./deploy.sh stop      ${DIM}# stop server${NC}\n\n"
}

# ── Fix image name mismatch ───────────────────────────────────────────────────
do_fix() {
  header "setup-deploy — Fix Image Name Mismatch"

  # ── Require both files ────────────────────────────────────────────────────
  if [ ! -f "deploy.config.sh" ]; then
    err "deploy.config.sh not found in current directory."
    hint "Run from inside your project folder: cd my-project && setup-deploy --fix"
    exit 1
  fi
  if [ ! -f "docker-compose.yml" ]; then
    err "docker-compose.yml not found in current directory."
    hint "Make sure docker-compose.yml exists in your project root"
    exit 1
  fi

  source "deploy.config.sh"

  # ── Extract image name from docker-compose.yml ────────────────────────────
  # Matches lines like:  image: myapp  or  image: myapp:latest  (with any indent)
  COMPOSE_IMAGE=$(grep -E '^\s*image\s*:' docker-compose.yml | head -1 | sed 's/.*image\s*:\s*//' | sed 's/:.*//' | tr -d ' "'"'" )

  # ── Case 1: no image: line at all (e.g. dev compose using build:) ─────────
  if [ -z "$COMPOSE_IMAGE" ]; then
    printf "  ${YELLOW}No 'image:' line found in docker-compose.yml${NC}\n\n"
    printf "  The deploy tool needs an ${BOLD}image:${NC} line in your service so it can\n"
    printf "  run the pre-built image instead of building from source on the server.\n\n"
    printf "  IMAGE_NAME in deploy.config.sh: ${BOLD}${GREEN}%s${NC}\n\n" "$IMAGE_NAME"
    printf "  Add   ${CYAN}image: %s${NC}   to your service in docker-compose.yml? (Y/n): " "$IMAGE_NAME" >&2
    read add_confirm
    add_confirm="${add_confirm:-y}"
    if [ "$add_confirm" = "n" ] || [ "$add_confirm" = "N" ]; then
      printf "  Aborted. Add the image: line manually and run again.\n\n"
      exit 0
    fi

    # Find the first service block's first key (build:, command:, ports:, etc.)
    # and insert image: above it, indented to match
    local _tmp
    _tmp=$(mktemp)
    # Use awk: after we see a line matching "^\s+build:|command:|ports:|volumes:|env"
    # inside a services block, insert image: once before the first such line
    awk -v img="$IMAGE_NAME" '
      /^services:/ { in_services=1 }
      in_services && !inserted && /^[[:space:]]+(build|command|ports|volumes|environment|env_file|healthcheck)[[:space:]]*:/ {
        # Capture the indentation of this line
        match($0, /^[[:space:]]+/)
        indent = substr($0, 1, RLENGTH)
        print indent "image: " img
        inserted=1
      }
      { print }
    ' docker-compose.yml > "$_tmp"

    if grep -q "image: $IMAGE_NAME" "$_tmp"; then
      mv "$_tmp" docker-compose.yml
      success "docker-compose.yml updated — added:  image: $IMAGE_NAME"
    else
      rm -f "$_tmp"
      err "Could not auto-insert image: line. Please add it manually:"
      printf "\n  services:\n    app:\n      image: %s\n      ...\n\n" "$IMAGE_NAME"
      exit 1
    fi

    printf "\n"
    success "Fix applied! docker-compose.yml now has:  image: $IMAGE_NAME"
    printf "\n  Run:  ${CYAN}./deploy.sh push${NC}  to deploy.\n\n"
    exit 0
  fi

  # ── Case 2: image: line exists but matches — nothing to do ────────────────
  if [ "$IMAGE_NAME" = "$COMPOSE_IMAGE" ]; then
    success "No mismatch — IMAGE_NAME ('$IMAGE_NAME') already matches docker-compose.yml"
    printf "\n"
    exit 0
  fi

  # ── Case 3: image: line exists but doesn't match ──────────────────────────
  printf "  ${YELLOW}Mismatch detected:${NC}\n\n"
  printf "  ${BOLD}deploy.config.sh  IMAGE_NAME${NC} = ${RED}%s${NC}\n" "$IMAGE_NAME"
  printf "  ${BOLD}docker-compose.yml image:   ${NC} = ${RED}%s${NC}\n\n" "$COMPOSE_IMAGE"

  printf "  Which value is correct?\n\n"
  printf "  ${BOLD}1.${NC} Use ${GREEN}%-30s${NC} ${DIM}(update docker-compose.yml to match config)${NC}\n" "$IMAGE_NAME"
  printf "  ${BOLD}2.${NC} Use ${GREEN}%-30s${NC} ${DIM}(update deploy.config.sh to match compose)${NC}\n" "$COMPOSE_IMAGE"
  printf "  ${BOLD}3.${NC} Enter a new name manually\n\n"
  printf "  ? Choice [1]: " >&2
  read fix_choice
  fix_choice="${fix_choice:-1}"

  case "$fix_choice" in
    1) CORRECT_NAME="$IMAGE_NAME" ;;
    2) CORRECT_NAME="$COMPOSE_IMAGE" ;;
    3)
      while true; do
        printf "  ? New image name (lowercase, no spaces): " >&2
        read CORRECT_NAME
        if echo "$CORRECT_NAME" | grep -qE '^[a-z0-9_-]+$'; then break
        else err "Must be lowercase letters, numbers, hyphens, underscores only." >&2
        fi
      done
      ;;
    *)
      err "Invalid choice. Run setup-deploy --fix again."
      exit 1
      ;;
  esac

  printf "\n"
  info "Applying fix: image name = '$CORRECT_NAME'"
  printf "\n"

  if [ "$IMAGE_NAME" != "$CORRECT_NAME" ]; then
    sed -i.bak "s|^IMAGE_NAME=.*|IMAGE_NAME=\"${CORRECT_NAME}\"|" deploy.config.sh
    rm -f deploy.config.sh.bak
    success "deploy.config.sh updated  (IMAGE_NAME=\"$CORRECT_NAME\")"
  else
    info "deploy.config.sh already correct — no change"
  fi

  if [ "$COMPOSE_IMAGE" != "$CORRECT_NAME" ]; then
    sed -i.bak "s|^\(\s*image\s*:\s*\)${COMPOSE_IMAGE}|\1${CORRECT_NAME}|g" docker-compose.yml
    rm -f docker-compose.yml.bak
    success "docker-compose.yml updated (image: $CORRECT_NAME)"
  else
    info "docker-compose.yml already correct — no change"
  fi

  printf "\n"
  success "Fix applied! Both files now use image name: '$CORRECT_NAME'"
  printf "\n  Run:  ${CYAN}./deploy.sh push${NC}  to deploy.\n\n"
}

# ── Router ────────────────────────────────────────────────────────────────────
case "${1:-setup}" in
  --install)        do_install        ;;
  --update)         do_update         ;;
  --update-secrets) do_update_secrets ;;
  --fix)            do_fix            ;;
  setup|"")         do_setup          ;;
  *)
    printf "Usage: setup-deploy [--install | --update | --update-secrets | --fix]\n"
    exit 1
    ;;
esac
