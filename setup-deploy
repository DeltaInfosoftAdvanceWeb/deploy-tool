#!/bin/bash

# ── setup-deploy ──────────────────────────────────────────────────────────────
# Version: 2.5.0
# Usage:
#   setup-deploy               → setup new project
#   setup-deploy --install     → first time install on this Mac
#   setup-deploy --update      → update deploy engine from GitHub
#   setup-deploy --update-secrets → update server password in Keychain
#   setup-deploy --fix         → add image: line to docker-compose.yml if missing
# ─────────────────────────────────────────────────────────────────────────────
#
# IMPORTANT — why this file uses a main() wrapper:
# When --update runs, it overwrites THIS file on disk via mv. Bash reads
# scripts in ~4 KB chunks at seek offsets. Without the wrapper, bash would
# read the next chunk from the NEW file at the OLD offset and execute garbage.
# Wrapping everything in main() + calling it at the very last line forces bash
# to parse the entire file into memory before executing a single statement.
# ─────────────────────────────────────────────────────────────────────────────

main() {

DEPLOY_VERSION="2.5.0"
GITHUB_RAW="https://raw.githubusercontent.com/DeltaInfosoftAdvanceWeb/deploy-tool/main"
DEPLOY_DIR="$HOME/.deploy"

# ── Colors ────────────────────────────────────────────────────────────────────
BOLD='\033[1m'
DIM='\033[2m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
NC='\033[0m'

info()    { printf "${DIM} %s${NC}\n" "$1"; }
success() { printf "${GREEN} ✅ %s${NC}\n" "$1"; }
warn()    { printf "${YELLOW} ⚠️  %s${NC}\n" "$1"; }
err()     { printf "${RED} ❌ %s${NC}\n" "$1"; }
hint()    { printf "${DIM} → %s${NC}\n" "$1"; }

header() {
  printf "\n${BOLD}${BLUE}══════════════════════════════════════════${NC}\n"
  printf "${BOLD}${BLUE} %s${NC}\n" "$1"
  printf "${BOLD}${BLUE}══════════════════════════════════════════${NC}\n\n"
}

section() {
  printf "\n${BOLD}${CYAN} ── %s${NC}\n" "$1"
}

divider() {
  printf "${DIM} ──────────────────────────────────────────${NC}\n"
}

# ── Input helpers ─────────────────────────────────────────────────────────────

ask() {
  local prompt="$1"
  local default="$2"
  local value=""
  while [ -z "$value" ]; do
    if [ -n "$default" ]; then
      printf " ? %s [%s]: " "$prompt" "$default" >&2
    else
      printf " ? %s: " "$prompt" >&2
    fi
    read value
    if [ -z "$value" ] && [ -n "$default" ]; then
      value="$default"
    fi
    if [ -z "$value" ]; then
      err "This field cannot be empty. Please enter a value." >&2
    fi
  done
  echo "$value"
}

ask_optional() {
  local prompt="$1"
  printf " ? %s (optional, press Enter to skip): " "$prompt" >&2
  read value
  echo "$value"
}

ask_secret() {
  local prompt="$1"
  local value=""
  while [ -z "$value" ]; do
    printf " ? %s (hidden): " "$prompt" >&2
    read -s value
    printf "\n" >&2
    if [ -z "$value" ]; then
      err "This field cannot be empty." >&2
    fi
  done
  echo "$value"
}

ask_number() {
  local prompt="$1"
  local default="$2"
  local min="$3"
  local max="$4"
  local value=""
  while true; do
    if [ -n "$default" ]; then
      printf " ? %s [%s]: " "$prompt" "$default" >&2
    else
      printf " ? %s: " "$prompt" >&2
    fi
    read value
    if [ -z "$value" ] && [ -n "$default" ]; then
      value="$default"
    fi
    if [ -z "$value" ]; then
      err "This field cannot be empty." >&2; continue
    fi
    if ! echo "$value" | grep -qE '^[0-9]+$'; then
      err "Must be a number. You entered: $value" >&2
      hint "Example: $default" >&2; continue
    fi
    if [ -n "$min" ] && [ "$value" -lt "$min" ]; then
      err "Must be at least $min. You entered: $value" >&2; continue
    fi
    if [ -n "$max" ] && [ "$value" -gt "$max" ]; then
      err "Must be at most $max. You entered: $value" >&2; continue
    fi
    break
  done
  echo "$value"
}

# ── Validators ────────────────────────────────────────────────────────────────

validate_ip() {
  local ip="$1"
  if echo "$ip" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
    local a b c d
    IFS='.' read -r a b c d <<< "$ip"
    [ "$a" -le 255 ] && [ "$b" -le 255 ] && [ "$c" -le 255 ] && [ "$d" -le 255 ]
    return $?
  fi
  return 1
}

validate_port() {
  echo "$1" | grep -qE '^[0-9]+$' && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# ── Keychain helpers ──────────────────────────────────────────────────────────

keychain_save() {
  local account="$1"
  local service="$2"
  local secret="$3"
  security delete-generic-password -a "$account" -s "$service" 2>/dev/null || true
  if ! security add-generic-password -a "$account" -s "$service" -w "$secret" 2>/dev/null; then
    err "Failed to save to Keychain."
    exit 1
  fi
}

# ── Install ───────────────────────────────────────────────────────────────────

do_install() {
  header "setup-deploy — First Time Install v$DEPLOY_VERSION"

  info "Creating $DEPLOY_DIR ..."
  mkdir -p "$DEPLOY_DIR"
  success "Created $DEPLOY_DIR"

  info "Downloading deploy engine from GitHub..."
  if curl -fsSL "$GITHUB_RAW/deploy.sh" -o "$DEPLOY_DIR/deploy.sh" 2>/dev/null; then
    chmod +x "$DEPLOY_DIR/deploy.sh"
    success "Deploy engine downloaded"
  else
    err "Failed to download deploy.sh"
    hint "Make sure repo is public: github.com/DeltaInfosoftAdvanceWeb/deploy-tool"
    exit 1
  fi

  mkdir -p "$HOME/bin"
  cp "$0" "$HOME/bin/setup-deploy"
  chmod +x "$HOME/bin/setup-deploy"
  success "Installed setup-deploy to $HOME/bin"

  if ! grep -q 'export PATH="$HOME/bin:$PATH"' "$HOME/.zshrc" 2>/dev/null; then
    printf '\n# deploy-tool\nexport PATH="$HOME/bin:$PATH"\n' >> "$HOME/.zshrc"
    success "Added ~/bin to PATH in ~/.zshrc"
  else
    info "~/bin already in PATH"
  fi

  printf "\n"
  success "Install complete!"
  printf "\n ${BOLD}Activate:${NC} source ~/.zshrc\n"
  printf " ${BOLD}Setup project:${NC} cd your-project && setup-deploy\n\n"
}

# ── Update ────────────────────────────────────────────────────────────────────

do_update() {
  header "setup-deploy — Update Engine"

  info "Downloading latest deploy.sh..."
  if curl -fsSL "$GITHUB_RAW/deploy.sh" -o "$DEPLOY_DIR/deploy.sh" 2>/dev/null; then
    chmod +x "$DEPLOY_DIR/deploy.sh"
    success "Deploy engine updated"
  else
    err "Failed to download from GitHub"
    hint "Check internet connection or repo visibility"
    exit 1
  fi

  info "Updating setup-deploy CLI..."
  local _tmp_setup
  _tmp_setup=$(mktemp)
  if curl -fsSL "$GITHUB_RAW/setup-deploy" -o "$_tmp_setup" 2>/dev/null; then
    chmod +x "$_tmp_setup"
    mv "$_tmp_setup" "$HOME/bin/setup-deploy"
    success "setup-deploy CLI updated"
  else
    rm -f "$_tmp_setup"
    warn "Could not update setup-deploy CLI"
  fi

  printf "\n"
  success "Update complete!"
  printf "\n"
}

# ── Update secrets ────────────────────────────────────────────────────────────

do_update_secrets() {
  header "setup-deploy — Update Server Password"

  if [ ! -f "deploy.config.sh" ]; then
    err "No deploy.config.sh found in current directory."
    hint "Run from inside your project: cd my-project && setup-deploy --update-secrets"
    exit 1
  fi

  source "deploy.config.sh"

  printf " Updating secrets for: ${BOLD}%s${NC}\n\n" "$APP_NAME"

  section "Server SSH Password"
  SERVER_PASS=$(ask_secret "New server password")
  keychain_save "$SERVER_USER" "deploy-${APP_NAME}-server" "$SERVER_PASS"
  success "Server password updated in Keychain"

  printf "\n"
  success "Secrets updated for $APP_NAME"
  printf "\n"
}

# ── Setup ─────────────────────────────────────────────────────────────────────

do_setup() {
  header "setup-deploy — New Project Setup v$DEPLOY_VERSION"

  if [ ! -f "package.json" ]; then
    warn "No package.json found. Are you inside a Next.js project folder?"
    hint "Example: cd ~/Downloads/Developer/MyProject"
    printf " Continue anyway? (y/N): " >&2
    read confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
      printf " Aborted.\n"; exit 0
    fi
  fi

  printf " ${DIM}Answer each question. Press Enter to use [default] value.${NC}\n"
  printf " ${DIM}Server password stored in macOS Keychain. Client configs saved in deploy.config.sh.${NC}\n\n"

  while true; do

    # ── Step 1: App Name ──────────────────────────────────────────────────────
    section "Step 1 of 7 — App Name"
    info "Label to identify your app (e.g. CostMetrix, DeltaAuth)"
    while true; do
      APP_NAME=$(ask "App name")
      if echo "$APP_NAME" | grep -qE '^[a-zA-Z0-9_-]+$'; then break
      else
        err "Only letters, numbers, hyphens, underscores. No spaces." >&2
        hint "Example: MyApp, delta-auth" >&2
      fi
    done
    APP_NAME_LOWER=$(echo "$APP_NAME" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
    printf "\n"

    # ── Step 2: Tar File Name ─────────────────────────────────────────────────
    section "Step 2 of 7 — Tar File Name"
    info "Name for the exported Docker archive"
    while true; do
      TAR_FILE=$(ask "Tar file name" "${APP_NAME_LOWER}.tar")
      if echo "$TAR_FILE" | grep -qE '\.tar$'; then break
      else
        err "Must end with .tar" >&2
        hint "Example: myapp.tar" >&2
      fi
    done
    printf "\n"

    # ── Step 3: Server IP ─────────────────────────────────────────────────────
    section "Step 3 of 7 — Server IP Address"
    info "IP address of your Linux deployment server"
    while true; do
      SERVER_IP=$(ask "Server IP address (e.g. 192.168.1.249)")
      if validate_ip "$SERVER_IP"; then break
      else
        err "Invalid IP. You entered: $SERVER_IP" >&2
        hint "Must be 4 numbers separated by dots. Example: 192.168.1.249" >&2
      fi
    done
    printf "\n"

    # ── Step 4: Server User ───────────────────────────────────────────────────
    section "Step 4 of 7 — Server SSH Username"
    info "Username to SSH into your server"
    while true; do
      SERVER_USER=$(ask "Server SSH username" "devadmin")
      if echo "$SERVER_USER" | grep -qE '^[a-zA-Z0-9_-]+$'; then break
      else
        err "No spaces or special characters." >&2
        hint "Example: devadmin, ubuntu, root" >&2
      fi
    done
    printf "\n"

    # ── Step 5: App Port ──────────────────────────────────────────────────────
    section "Step 5 of 7 — App Port"
    info "Port your app will run on"
    while true; do
      APP_PORT=$(ask_number "App port" "3000" "1" "65535")
      if validate_port "$APP_PORT"; then break; fi
    done
    printf "\n"

    # ── Step 6: Server Path ───────────────────────────────────────────────────
    section "Step 6 of 7 — Server Folder Path"
    info "Folder on the server where app files will be uploaded"
    SERVER_PATH=$(ask "Server folder path" "~/$APP_NAME_LOWER")
    printf "\n"

    # ── Step 7: Clients ───────────────────────────────────────────────────────
    section "Step 7 of 7 — Clients"
    info "How many clients will this app deploy to? Enter 0 for single deployment."
    printf "\n"

    CLIENT_COUNT=$(ask_number "Number of clients" "0" "0" "20")
    printf "\n"

    # Arrays to hold all client data
    CLIENT_NAMES=()
    CLIENT_IDS=()
    CLIENT_ENVS=()

    if [ "$CLIENT_COUNT" -gt 0 ]; then
      local i=1
      while [ "$i" -le "$CLIENT_COUNT" ]; do

        printf "  ${BOLD}${CYAN}── Client $i of $CLIENT_COUNT ────────────────────────${NC}\n\n"

        # Client name
        local cname=""
        while true; do
          cname=$(ask "  Client name (e.g. GCKC, DARA, Samarth)")
          if echo "$cname" | grep -qE '^[a-zA-Z0-9_-]+$'; then
            # Check duplicate
            local dup=0
            for existing in "${CLIENT_NAMES[@]}"; do
              [ "$existing" = "$cname" ] && dup=1 && break
            done
            if [ "$dup" -eq 1 ]; then
              err "Client name '$cname' already used. Use a unique name." >&2
            else
              break
            fi
          else
            err "Only letters, numbers, hyphens, underscores. No spaces." >&2
          fi
        done

        # Client ID (optional)
        local cid=""
        cid=$(ask_optional "  Client ID for $cname")

        # Paste env vars for this client
        printf "\n"
        printf "  ${DIM}Paste all .env lines for ${BOLD}${cname}${NC}${DIM} below.${NC}\n"
        printf "  ${DIM}Press Enter on a blank line when done.${NC}\n\n"

        local cenv=""
        while IFS= read -r line; do
          [ -z "$line" ] && break
          cenv="${cenv}${line}"$'\n'
        done

        if [ -z "$cenv" ]; then
          warn "No env vars entered for $cname — .env will be empty for this client."
        else
          local lc
          lc=$(printf "%s" "$cenv" | grep -c '.' || true)
          success "$lc env var(s) captured for $cname"
        fi

        CLIENT_NAMES+=("$cname")
        CLIENT_IDS+=("$cid")
        CLIENT_ENVS+=("$cenv")

        printf "\n"
        i=$((i + 1))
      done

    else
      # Single deployment — paste one env block
      printf "\n"
      printf "  ${DIM}Paste your .env lines below. Press Enter on a blank line when done.${NC}\n\n"

      local single_env=""
      while IFS= read -r line; do
        [ -z "$line" ] && break
        single_env="${single_env}${line}"$'\n'
      done

      if [ -z "$single_env" ]; then
        warn "No env vars entered — .env will be empty on server."
      else
        local lc
        lc=$(printf "%s" "$single_env" | grep -c '.' || true)
        success "$lc env var(s) captured"
      fi

      CLIENT_NAMES=("__single__")
      CLIENT_IDS=("")
      CLIENT_ENVS=("$single_env")
    fi

    printf "\n"

    # ── Server password ───────────────────────────────────────────────────────
    section "Server SSH Password"
    info "Password to SSH into your server (hidden, stored in macOS Keychain only)"
    SERVER_PASS=$(ask_secret "Server SSH password")
    keychain_save "$SERVER_USER" "deploy-${APP_NAME}-server" "$SERVER_PASS"
    success "Server password saved to Keychain"
    printf "\n"

    section "Configuring server permissions"
    info "Setting up docker group and passwordless sudo on server..."

    sshpass -p "$SERVER_PASS" ssh -o StrictHostKeyChecking=no \
      "$SERVER_USER@$SERVER_IP" \
      "sudo usermod -aG docker $SERVER_USER" 2>/dev/null && \
      success "User added to docker group" || \
      warn "Could not add to docker group — sudo prefix will be used instead"

    sshpass -p "$SERVER_PASS" ssh -o StrictHostKeyChecking=no \
      "$SERVER_USER@$SERVER_IP" \
      "echo '$SERVER_USER ALL=(ALL) NOPASSWD: /usr/bin/docker, /usr/local/bin/docker' | sudo tee /etc/sudoers.d/deploy-docker > /dev/null" 2>/dev/null && \
      success "Passwordless sudo configured for docker" || \
      warn "Could not configure sudoers — you may need to do it manually"
    printf "\n"

    # ── Summary ───────────────────────────────────────────────────────────────
    printf "\n${BOLD}${MAGENTA}══════════════════════════════════════════${NC}\n"
    printf "${BOLD}${MAGENTA} Review Your Configuration${NC}\n"
    printf "${BOLD}${MAGENTA}══════════════════════════════════════════${NC}\n\n"
    printf "  ${BOLD}App name    :${NC} %s\n" "$APP_NAME"
    printf "  ${BOLD}Tar file    :${NC} %s\n" "$TAR_FILE"
    printf "  ${BOLD}Server IP   :${NC} %s\n" "$SERVER_IP"
    printf "  ${BOLD}SSH user    :${NC} %s\n" "$SERVER_USER"
    printf "  ${BOLD}App port    :${NC} %s\n" "$APP_PORT"
    printf "  ${BOLD}Server path :${NC} %s\n" "$SERVER_PATH"
    printf "  ${BOLD}SSH password:${NC} ${DIM}(stored in Keychain)${NC}\n"

    if [ "$CLIENT_COUNT" -gt 0 ]; then
      printf "  ${BOLD}Clients     :${NC}\n"
      local j=0
      while [ "$j" -lt "${#CLIENT_NAMES[@]}" ]; do
        local cname="${CLIENT_NAMES[$j]}"
        local cid="${CLIENT_IDS[$j]}"
        local cenv="${CLIENT_ENVS[$j]}"
        local lc
        lc=$(printf "%s" "$cenv" | grep -c '.' 2>/dev/null || echo 0)
        if [ -n "$cid" ]; then
          printf "\n    ${BOLD}%s${NC} ${DIM}(ID: %s)${NC} — %s env var(s)\n" "$cname" "$cid" "$lc"
        else
          printf "\n    ${BOLD}%s${NC} — %s env var(s)\n" "$cname" "$lc"
        fi
        printf "%s" "$cenv" | while IFS= read -r l; do
          [ -n "$l" ] && printf "      ${DIM}%s${NC}\n" "$l"
        done
        j=$((j + 1))
      done
    else
      local lc
      lc=$(printf "%s" "${CLIENT_ENVS[0]}" | grep -c '.' 2>/dev/null || echo 0)
      printf "  ${BOLD}Env vars    :${NC} %s var(s)\n" "$lc"
      printf "%s" "${CLIENT_ENVS[0]}" | while IFS= read -r l; do
        [ -n "$l" ] && printf "    ${DIM}%s${NC}\n" "$l"
      done
    fi

    printf "\n"
    divider
    printf "\n ${YELLOW}Does everything look correct?${NC}\n"
    printf " ${DIM}Press 'y' to save and finish, 'n' to start over.${NC}\n\n"
    printf " Confirm? (y/N): " >&2
    read final_confirm
    printf "\n"

    if [ "$final_confirm" = "y" ] || [ "$final_confirm" = "Y" ]; then
      break
    else
      warn "Starting over..."
      printf "\n"
      CLIENT_NAMES=()
      CLIENT_IDS=()
      CLIENT_ENVS=()
    fi

  done

  # ── Write deploy.config.sh ────────────────────────────────────────────────
  info "Writing deploy.config.sh ..."

  {
    printf "# ── Deploy Configuration ────────────────────────────────────────────────────\n"
    printf "# Generated by setup-deploy v%s\n" "$DEPLOY_VERSION"
    printf "# Server password stored in macOS Keychain — NOT here\n"
    printf "# IMAGE_NAME is read from docker-compose.yml at deploy time — not stored here\n\n"
    printf "APP_NAME=\"%s\"\n" "$APP_NAME"
    printf "TAR_FILE=\"%s\"\n" "$TAR_FILE"
    printf "SERVER_IP=\"%s\"\n" "$SERVER_IP"
    printf "SERVER_USER=\"%s\"\n" "$SERVER_USER"
    printf "SERVER_PATH=\"%s\"\n" "$SERVER_PATH"
    printf "APP_PORT=\"%s\"\n\n" "$APP_PORT"

    if [ "$CLIENT_COUNT" -gt 0 ]; then
      # Build space-separated client name list
      local names_list=""
      local j=0
      while [ "$j" -lt "${#CLIENT_NAMES[@]}" ]; do
        names_list="$names_list ${CLIENT_NAMES[$j]}"
        j=$((j + 1))
      done
      names_list="${names_list# }"   # trim leading space

      printf "# Clients (space-separated)\n"
      printf "DEPLOY_CLIENTS=\"%s\"\n\n" "$names_list"

      # Write each client block
      local j=0
      while [ "$j" -lt "${#CLIENT_NAMES[@]}" ]; do
        local cname="${CLIENT_NAMES[$j]}"
        local cid="${CLIENT_IDS[$j]}"
        local cenv="${CLIENT_ENVS[$j]}"
        local escaped_env
        escaped_env=$(printf "%s" "$cenv" | sed "s/'/'\\\\''/g")

        printf "# ── Client: %s ──\n" "$cname"
        printf "CLIENT_%s_NAME=\"%s\"\n" "$cname" "$cname"
        if [ -n "$cid" ]; then
          printf "CLIENT_%s_ID=\"%s\"\n" "$cname" "$cid"
        else
          printf "CLIENT_%s_ID=\"\"\n" "$cname"
        fi
        printf "CLIENT_%s_ENV='%s'\n\n" "$cname" "$escaped_env"

        j=$((j + 1))
      done

    else
      # Single deployment
      printf "# Single deployment (no clients)\n"
      printf "DEPLOY_CLIENTS=\"\"\n\n"
      local escaped_env
      escaped_env=$(printf "%s" "${CLIENT_ENVS[0]}" | sed "s/'/'\\\\''/g")
      printf "# Environment variables\n"
      printf "PASTED_ENV_VARS='%s'\n" "$escaped_env"
    fi

  } > deploy.config.sh

  success "deploy.config.sh created"

  # ── Write .env locally (first client or single) ───────────────────────────
  if [ "$CLIENT_COUNT" -gt 0 ]; then
    printf "%s" "${CLIENT_ENVS[0]}" > .env
    success ".env written locally for first client (${CLIENT_NAMES[0]})"
  else
    printf "%s" "${CLIENT_ENVS[0]}" > .env
    success ".env written locally"
  fi

  # ── Write deploy.sh wrapper ───────────────────────────────────────────────
  info "Writing deploy.sh ..."
  cat > deploy.sh << 'EOF'
#!/bin/bash
# Generated by setup-deploy — safe to commit, no secrets here
source "$HOME/.deploy/deploy.sh" "$@"
EOF
  chmod +x deploy.sh
  success "deploy.sh created"

  # ── Update .gitignore ─────────────────────────────────────────────────────
  info "Updating .gitignore ..."
  [ ! -f ".gitignore" ] && touch .gitignore

  if ! grep -q "deploy.config.sh" .gitignore; then
    printf "\n# deploy tool\ndeploy.config.sh\n" >> .gitignore
    success "deploy.config.sh added to .gitignore"
  else
    info "deploy.config.sh already in .gitignore"
  fi

  # ── Done ─────────────────────────────────────────────────────────────────
  printf "\n${BOLD}${GREEN}══════════════════════════════════════════${NC}\n"
  printf "${BOLD}${GREEN} ✅ Project setup complete!${NC}\n"
  printf "${BOLD}${GREEN}══════════════════════════════════════════${NC}\n\n"
  printf " ${BOLD}Files created:${NC}\n"
  printf "  ${DIM}deploy.sh        — safe to commit${NC}\n"
  printf "  ${DIM}deploy.config.sh — gitignored, no secrets${NC}\n"
  printf "  ${DIM}.env             — written from first client / single env${NC}\n\n"
  printf " ${BOLD}Deploy commands:${NC}\n"
  if [ "$CLIENT_COUNT" -gt 0 ]; then
    printf "  ${CYAN}./deploy.sh push --client CLIENTNAME  ${DIM}# deploy specific client${NC}\n"
    printf "  ${CYAN}./deploy.sh push                      ${DIM}# shows client list to pick${NC}\n"
  else
    printf "  ${CYAN}./deploy.sh push     ${DIM}# build + upload + restart${NC}\n"
  fi
  printf "  ${CYAN}./deploy.sh restart  ${DIM}# just restart server${NC}\n"
  printf "  ${CYAN}./deploy.sh logs     ${DIM}# tail live logs${NC}\n"
  printf "  ${CYAN}./deploy.sh stop     ${DIM}# stop server${NC}\n\n"
}

# ── Fix image name mismatch ───────────────────────────────────────────────────

do_fix() {
  header "setup-deploy — Fix Image Name Mismatch"

  if [ ! -f "deploy.config.sh" ]; then
    err "deploy.config.sh not found in current directory."
    hint "Run from inside your project folder: cd my-project && setup-deploy --fix"
    exit 1
  fi

  if [ ! -f "docker-compose.yml" ]; then
    err "docker-compose.yml not found in current directory."
    hint "Make sure docker-compose.yml exists in your project root"
    exit 1
  fi

  source "deploy.config.sh"

  COMPOSE_IMAGE=$(grep -E '^\s*image\s*:' docker-compose.yml | head -1 \
    | sed 's/.*image\s*:\s*//' | sed 's/:.*//' | tr -d ' "'"'")

  if [ -n "$COMPOSE_IMAGE" ]; then
    success "docker-compose.yml already has: image: $COMPOSE_IMAGE"
    printf "  ${DIM}The deploy engine will use this image name automatically.${NC}\n\n"
    exit 0
  fi

  printf "  ${YELLOW}No 'image:' line found in docker-compose.yml${NC}\n\n"
  printf "  The deploy engine reads the image name directly from docker-compose.yml.\n"
  printf "  You need to add an ${BOLD}image:${NC} line to your service.\n\n"

  while true; do
    printf " ? Image name to use (lowercase, e.g. auth, myapp): " >&2
    read NEW_IMAGE
    if echo "$NEW_IMAGE" | grep -qE '^[a-z0-9_-]+$'; then break
    else err "Must be lowercase letters, numbers, hyphens, underscores only." >&2
    fi
  done

  local _tmp
  _tmp=$(mktemp)

  awk -v img="$NEW_IMAGE" '
    /^services:/ { in_services=1 }
    in_services && !inserted && /^[[:space:]]+(build|command|ports|volumes|environment|env_file|healthcheck)[[:space:]]*:/ {
      match($0, /^[[:space:]]+/)
      indent = substr($0, 1, RLENGTH)
      print indent "image: " img
      inserted=1
    }
    { print }
  ' docker-compose.yml > "$_tmp"

  if grep -q "image: $NEW_IMAGE" "$_tmp"; then
    mv "$_tmp" docker-compose.yml
    printf "\n"
    success "docker-compose.yml updated — added: image: $NEW_IMAGE"
    printf "\n  Run: ${CYAN}./deploy.sh push${NC} to deploy.\n\n"
  else
    rm -f "$_tmp"
    err "Could not auto-insert image: line. Add it manually:"
    printf "\n  services:\n    app:\n      image: %s\n\n" "$NEW_IMAGE"
    exit 1
  fi
}

# ── Router ────────────────────────────────────────────────────────────────────

case "${1:-setup}" in
  --install)        do_install ;;
  --update)         do_update ;;
  --update-secrets) do_update_secrets ;;
  --fix)            do_fix ;;
  setup|"")         do_setup ;;
  *)
    printf "Usage: setup-deploy [--install | --update | --update-secrets | --fix]\n"
    exit 1
    ;;
esac

} # end main()

# Calling main() as the very last line forces bash to parse the entire file
# into memory before executing anything — safe for self-replacing scripts.
main "$@"
